# =============================================================================
# Omni Counter demo dApp – environment variables
# =============================================================================
# Copy to .env.local and fill in. Used at build time and in the browser.
# =============================================================================

# Relayer base URL (must be reachable from the user's browser)
NEXT_PUBLIC_RELAYER_URL=http://localhost:3001

# Rootstock RPC (testnet or mainnet)
NEXT_PUBLIC_RPC_URL=https://public-node.testnet.rsk.co

# Deployed contract addresses (from your contracts deployment)
NEXT_PUBLIC_SMART_ACCOUNT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_COUNTER_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: Rootstock chain ID (31 testnet, 30 mainnet). If unset, inferred from NEXT_PUBLIC_RPC_URL when possible.
# NEXT_PUBLIC_CHAIN_ID=31

# Optional: must match relayer RELAYER_API_KEY when the relayer is configured to require it.
# NEXT_PUBLIC_RELAYER_API_KEY=
