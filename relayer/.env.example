# =============================================================================
# Rootstock Omni-Key – Relayer environment variables
# =============================================================================
# Copy to .env and fill in. Never commit .env.
# =============================================================================

# Rootstock RPC URL (testnet or mainnet). If you get ETIMEDOUT/ENETUNREACH, try:
# https://rootstock-testnet.drpc.org  or  https://public-node.testnet.rsk.co
ROOTSTOCK_RPC_URL=https://public-node.testnet.rsk.co

# Relayer wallet private key (pays gas). No 0x prefix.
RELAYER_PRIVATE_KEY=

# Default SmartAccount contract address (optional if frontend always sends smartAccount)
# SMART_ACCOUNT_ADDRESS=0x78cb47B2C97922471435d516D17a448BB74015B0

# Comma-separated allowlist of browser origins permitted to call the relayer (no wildcard).
# Example: http://localhost:3000,https://your-demo-domain.com
CORS_ORIGINS=http://localhost:3000

# Rate limit per IP (token bucket style). Tune depending on funding + expected traffic.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Server port
PORT=3001
